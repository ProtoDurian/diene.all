{
  "uid": "sandbox-sample-overview",
  "title": "Sample — Requests overview",
  "description": "Sandbox fixture only: proves the stack renders. Its request panels are generic ones, which never belong on a curated dashboard.",
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Prometheus data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "landscape",
        "label": "Landscape",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$prometheus_datasource"
        },
        "definition": "label_values(sample_requests_total, landscape)",
        "query": {
          "query": "label_values(sample_requests_total, landscape)",
          "refId": "landscape"
        },
        "refresh": 2,
        "current": {
          "text": "pichu",
          "value": "pichu"
        }
      },
      {
        "name": "loki_datasource",
        "label": "Loki data source",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "filter",
        "label": "Filter",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 4,
      "type": "text",
      "title": "About this dashboard",
      "description": "Purpose, audience and where to go next.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Sandbox fixture (its links keep their placeholders; a real dashboard holds the real values): request rate, errors and latency of the `sample` service. For whoever checks that the sandbox renders. Next: [System overview]({repo-url}/observability/overview.md) · [Generic dashboard](/d/{generic-dashboard-uid})"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / second",
      "description": "Requests per second by outcome. Bad: a sudden drop while traffic is expected.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus_datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus_datasource"
          },
          "expr": "sum by (outcome) (rate(sample_requests_total{service=\"sample\",landscape=\"$landscape\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio",
      "description": "Share of requests that failed. Over 1% needs a look; over 5% means users see errors.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus_datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "gradientMode": "scheme",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus_datasource"
          },
          "expr": "sum by (service) (rate(sample_requests_total{service=\"sample\",landscape=\"$landscape\",outcome=\"error\"}[$__rate_interval])) / sum by (service) (rate(sample_requests_total{service=\"sample\",landscape=\"$landscape\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "95th percentile request duration. Over 250 ms needs a look; over 500 ms users wait.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$prometheus_datasource"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "gradientMode": "scheme",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "$prometheus_datasource"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sample_request_duration_seconds_bucket{service=\"sample\",landscape=\"$landscape\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Errors in detail",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Error log lines",
      "description": "UNVERIFIED: the sandbox has no log store. Error lines of the sample service, newest first. An empty panel on a healthy service is correct.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "$loki_datasource"
      },
      "options": {
        "sortOrder": "Descending",
        "dedupStrategy": "exact",
        "showTime": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "$loki_datasource"
          },
          "expr": "{service=\"sample\",landscape=\"$landscape\"} |= \"error\" |~ \"$filter\"",
          "maxLines": 100
        }
      ]
    }
  ]
}
