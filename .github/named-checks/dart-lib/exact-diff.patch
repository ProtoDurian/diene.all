diff --git a/Taskfile.yaml b/Taskfile.yaml
index 89749938..b4680cd7 100644
--- a/Taskfile.yaml
+++ b/Taskfile.yaml
@@ -1,5 +1,19 @@
 version: '3'
 
+includes:
+  unit:
+    taskfile: tasks/Taskfile.test.yaml
+    vars:
+      MODE: unit
+  meta:
+    taskfile: tasks/Taskfile.test.yaml
+    vars:
+      MODE: meta
+  consumer:
+    taskfile: tasks/Taskfile.test.yaml
+    vars:
+      MODE: consumer
+
 tasks:
   setup:
     desc: Set up the workspace
@@ -10,3 +24,67 @@ tasks:
     desc: Run all repository gates
     cmds:
       - pre-commit run --all-files
+
+  clean:
+    desc: Remove Dart dependency, build, coverage, and generated-doc artifacts
+    cmds:
+      - rm -rf .dart_tool packages/diene_dart_lib/.dart_tool reports packages/diene_dart_lib/doc/api
+
+  build:
+    desc: Validate the publishable Dart library and example
+    cmds:
+      - dart pub get >/dev/null
+      - dart analyze --fatal-infos packages/diene_dart_lib/lib packages/diene_dart_lib/example
+
+  analyze:
+    desc: Analyze the whole workspace, tests, and tooling
+    cmds:
+      - ./scripts/ci/analyze.sh
+
+  deadcode:
+    desc: Run repository and production-only dead-code passes
+    cmds:
+      - ./scripts/local/deadcode.sh
+
+  package:validate:
+    desc: Validate package metadata, pana score, and pub.dev dry-run contents
+    cmds:
+      - ./scripts/ci/package-validate.sh
+
+  test:
+    desc: Run unit/C0, TestHelper meta and consumer tiers without coverage
+    cmds:
+      - task: unit:default
+      - task: meta:default
+      - task: consumer:default
+
+  test:unit:
+    desc: Run unit and C0 conformance suites without coverage
+    cmds:
+      - task: unit:default
+
+  test:meta:
+    desc: Run assert-the-asserter tests for TestHelper
+    cmds:
+      - task: meta:default
+
+  test:consumer:
+    desc: Pack the package, install the local archive in a fresh project, then import, run, compile and type-check it
+    cmds:
+      - task: consumer:default
+
+  test:coverage:
+    desc: Run every coverage-capable tier with its isolated ledger
+    cmds:
+      - task: unit:coverage
+      - task: meta:coverage
+
+  test:unit:coverage:
+    desc: Run unit and C0 tests with the unit-only coverage ledger
+    cmds:
+      - task: unit:coverage
+
+  test:meta:coverage:
+    desc: Run TestHelper meta tests with the helper-only coverage ledger
+    cmds:
+      - task: meta:coverage
