<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org only: Result and Interfaces must resolve from the registry, never a local feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
