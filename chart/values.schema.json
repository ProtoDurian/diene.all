{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Xenon Values",
    "description": "Generated schema for the diene xenon metrics-server wrapper.",
    "type": "object",
    "required": [
        "builtInMetricsProvider"
    ],
    "properties": {
        "builtInMetricsProvider": {
            "description": "The declared fact the toggle derives from: true when the cluster already serves `v1beta1.metrics.k8s.io` (k3s bundles metrics-server). Then `upstream.enabled` must be false; otherwise it must be true.",
            "type": "boolean"
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "metrics-server 3.14.0 (app 0.9.0, Kubernetes 1.34+) values: upstream defaults plus the toggle, LPSM labels, Reloader, pod non-root and limits. No ServiceMonitor, no metrics endpoint (upstream defaults stay off).",
            "type": "object",
            "properties": {
                "commonLabels": {
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    }
                },
                "deploymentAnnotations": {
                    "type": "object",
                    "properties": {
                        "reloader.stakater.com/auto": {
                            "type": "string"
                        }
                    }
                },
                "enabled": {
                    "description": "The xenon toggle (Helm dependency condition). ON exactly when `builtInMetricsProvider` is false.",
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "description": "Conforming `\u003cservice\u003e-\u003ctoken\u003e` name for every upstream object.",
                    "type": "string"
                },
                "podLabels": {
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    }
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
