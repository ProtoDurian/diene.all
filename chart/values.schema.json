                        "platforms": {
                            "description": "Accepted `\u003clabelPrefix\u003e/platform` values.",
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "requireAnnotations": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "requireLabels": {
                    "type": "object",
                    "properties": {
                        "actions": {
