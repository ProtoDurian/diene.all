        "secret": {
            "description": "One service-scoped ExternalSecret with folder-prefix rewrites; the only path for backend credentials.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "refreshInterval": {
                    "type": "string"
