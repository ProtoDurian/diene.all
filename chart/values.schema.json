{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Zinc Values",
    "description": "Generated schema for the diene zinc issuer chart.",
    "type": "object",
    "properties": {
        "issuer": {
            "description": "The one reusable Let's Encrypt DNS-01 (Cloudflare) ClusterIssuer definition. Overlays only pick refs and zones.",
            "type": "object",
            "properties": {
                "cloudflareTokenKey": {
                    "description": "Token key under `secret.serviceFolder`; the ExternalSecret adds the folder prefix.",
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$"
                },
                "directories": {
                    "type": "object",
                    "properties": {
                        "production": {
                            "type": "string"
                        },
                        "staging": {
                            "type": "string"
                        }
                    }
                },
                "dnsZones": {
                    "description": "DNS-01 solver zone restriction. Empty means any zone the token can edit.",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                "email": {
                    "type": "string",
                    "pattern": "^[^@\\s]+@[^@\\s]+$"
                },
                "refs": {
                    "description": "ClusterIssuers to materialize, each named `zinc-\u003ctoken\u003e`. Registered rows keep `zinc-letsencrypt`.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "token",
                            "directory"
                        ],
                        "properties": {
                            "directory": {
                                "type": "string",
                                "enum": [
                                    "production",
                                    "staging"
                                ]
                            },
                            "token": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+$"
                            }
                        }
                    }
                }
            }
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation helper.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "secret": {
            "description": "The one ExternalSecret: the Cloudflare API token from the platform SecretStore (carbon), folder-prefixed.",
            "type": "object",
            "properties": {
                "refreshInterval": {
                    "type": "string",
                    "pattern": "^[0-9]+(s|m|h)$"
                },
                "serviceFolder": {
                    "type": "string",
                    "pattern": "^/.+"
                },
                "sharedFolder": {
                    "type": "string",
                    "pattern": "^/.+"
                },
                "store": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "SecretStore",
                                "ClusterSecretStore"
                            ]
                        },
                        "name": {
                            "description": "Platform SecretStore name; carbon has not pinned it yet.",
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape is added by the landscape overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "description": "cert-manager reads DNS-01 secrets from its cluster resource namespace: sulfur's `certs`.",
                    "type": "string",
                    "enum": [
                        "certs"
                    ]
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        }
    }
}
