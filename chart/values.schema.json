{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Chlorine Values",
    "description": "Generated schema for the diene chlorine Reloader wrapper.",
    "type": "object",
    "properties": {
        "labelPrefix": {
            "description": "Label prefix. No template reads it: the upstream labels below are literals that must match it and serviceTree.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "stakater/reloader overrides: annotation opt-in (never auto-reload-all), LPSM labels, self opt-in, hardening, limits.",
            "type": "object",
            "properties": {
                "fullnameOverride": {
                    "type": "string"
                },
                "nameOverride": {
                    "type": "string"
                },
                "reloader": {
                    "type": "object",
                    "properties": {
                        "autoReloadAll": {
                            "type": "boolean"
                        },
                        "deployment": {
                            "type": "object",
                            "properties": {
                                "annotations": {
                                    "type": "object",
                                    "properties": {
                                        "reloader.stakater.com/auto": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "containerSecurityContext": {
                                    "type": "object",
                                    "properties": {
                                        "allowPrivilegeEscalation": {
                                            "type": "boolean"
                                        },
                                        "capabilities": {
                                            "type": "object",
                                            "properties": {
                                                "drop": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "runAsNonRoot": {
                                            "type": "boolean"
                                        }
                                    }
                                },
                                "labels": {
                                    "type": "object",
                                    "properties": {
                                        "atomi.cloud/layer": {
                                            "type": "string"
                                        },
                                        "atomi.cloud/module": {
                                            "type": "string"
                                        },
                                        "atomi.cloud/platform": {
                                            "type": "string"
                                        },
                                        "atomi.cloud/service": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "resources": {
                                    "type": "object",
                                    "properties": {
                                        "limits": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        },
                                        "requests": {
                                            "type": "object",
                                            "properties": {
                                                "cpu": {
                                                    "type": "string"
                                                },
                                                "memory": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "rbac": {
                            "type": "object",
                            "properties": {
                                "labels": {}
                            }
                        },
                        "readOnlyRootFileSystem": {
                            "type": "boolean"
                        },
                        "serviceAccount": {
                            "type": "object",
                            "properties": {
                                "labels": {}
                            }
                        }
                    }
                }
            }
        }
    }
}
