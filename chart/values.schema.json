{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Platinum Values",
    "description": "Generated schema for the diene platinum kgateway wrapper.",
    "type": "object",
    "required": [
        "fullnameOverride"
    ],
    "properties": {
        "crds": {
            "description": "kgateway CRDs (pinned). Installed once per cluster as its own release before platinum.",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "devHost": {
            "description": "ENTEI dev-host shared-Gateway role. Platinum renders the shared edge only; per-host Certificate, ListenerSet, and HTTPRoute belong to the exposure materializer.",
            "type": "object",
            "properties": {
                "emergencyListeners": {
                    "description": "Emergency-only direct listeners on the shared Gateway. They count against the Gateway listener ceiling that ListenerSet avoids.",
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "listeners": {
                            "type": "array",
                            "items": {
                                "type": "object"
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "listenerSetNamespaceLabel": {
                    "description": "Namespace label (under labelPrefix, value \"true\") that admits a namespace's ListenerSets.",
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                }
            }
        },
        "fullnameOverride": {
            "description": "Primary workload fullname (`\u003cservice\u003e-\u003cmodule\u003e`): the kgateway control plane.",
            "type": "string",
            "pattern": "^[a-z0-9]+-[a-z0-9]+$"
        },
        "gateway": {
            "description": "Shared Gateway API edge: GatewayClass, one shared Gateway, the provider LoadBalancer, and the health route.",
            "type": "object",
            "properties": {
                "aws": {
                    "type": "object",
                    "properties": {
                        "eipAllocationIds": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        },
                        "subnetIds": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "className": {
                    "description": "GatewayClass name platinum owns.",
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "controllerName": {
                    "description": "kgateway's controller name.",
                    "type": "string",
                    "enum": [
                        "kgateway.dev/kgateway"
                    ]
                },
                "enabled": {
                    "type": "boolean"
                },
                "health": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "description": "Fixed path the traffic controller polls once per cluster per tick.",
                            "type": "string",
                            "pattern": "^/.*"
                        },
                        "status": {
                            "type": "integer",
                            "maximum": 299,
                            "minimum": 200
                        }
                    }
                },
                "oci": {
                    "type": "object",
                    "properties": {
                        "reservedPublicIp": {
                            "type": "string"
                        }
                    }
                },
                "port": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                },
                "provider": {
                    "type": "string",
                    "enum": [
                        "aws",
                        "oci",
                        "digitalocean",
                        "local"
                    ]
                },
                "tlsPort": {
                    "type": "integer",
                    "maximum": 65535,
                    "minimum": 1
                }
            }
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation helper.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "registeredCertificates": {
            "description": "Registered-fleet wildcard Certificates against zinc's DNS-01 ClusterIssuer. Platinum renders no issuer.",
            "type": "object",
            "properties": {
                "backup": {
                    "type": "object",
                    "properties": {
                        "domain": {
                            "description": "S8 Route53 backup base domain wildcard (tokenize before live use).",
                            "type": "string",
                            "pattern": "^\\*\\.[a-z0-9.-]+$"
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "issuerRef": {
                    "type": "object",
                    "properties": {
                        "kind": {
                            "type": "string",
                            "enum": [
                                "ClusterIssuer"
                            ]
                        },
                        "name": {
                            "description": "ClusterIssuer instantiated per cluster by charts/zinc.",
                            "type": "string"
                        }
                    }
                },
                "primary": {
                    "type": "object",
                    "properties": {
                        "domain": {
                            "type": "string",
                            "pattern": "^\\*\\.[a-z0-9.-]+$"
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "kgateway control plane (pinned). Its labels must equal the LPSM set.",
            "type": "object",
            "properties": {
                "commonLabels": {
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": true
                },
                "controller": {
                    "type": "object",
                    "properties": {
                        "image": {
                            "type": "object",
                            "properties": {
                                "repository": {
                                    "type": "string"
                                },
                                "tag": {
                                    "type": "string"
                                }
                            }
                        },
                        "podAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        },
                        "podSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsGroup": {
                                    "type": "integer"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                },
                                "runAsUser": {
                                    "type": "integer"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        },
                        "securityContext": {
                            "type": "object",
                            "properties": {
                                "allowPrivilegeEscalation": {
                                    "type": "boolean"
                                },
                                "capabilities": {
                                    "type": "object",
                                    "properties": {
                                        "drop": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                "readOnlyRootFilesystem": {
                                    "type": "boolean"
                                },
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                },
                "fullnameOverride": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+-[a-z0-9]+$"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
