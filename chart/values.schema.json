{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Cobalt Values",
    "description": "Generated schema for the diene cobalt External Secrets Operator wrapper.",
    "type": "object",
    "properties": {
        "labelPrefix": {
            "description": "Prefix used by every service-tree label and annotation.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "store": {
            "description": "The `infisical` ClusterSecretStore: SoS project, environment = serviceTree.landscape, pull-only.",
            "type": "object",
            "required": [
                "name",
                "hostAPI",
                "project",
                "readerLabel"
            ],
            "properties": {
                "credentials": {
                    "description": "SoS bootstrap credential, written into the cluster by T3 provisioning. References only.",
                    "type": "object",
                    "required": [
                        "secretName",
                        "namespace",
                        "clientIdKey",
                        "clientSecretKey"
                    ],
                    "properties": {
                        "clientIdKey": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9._-]+$"
                        },
                        "clientSecretKey": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9._-]+$"
                        },
                        "namespace": {
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        },
                        "secretName": {
                            "type": "string",
                            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                        }
                    },
                    "additionalProperties": false
                },
                "hostAPI": {
                    "type": "string",
                    "pattern": "^https://[a-z0-9.-]+$"
                },
                "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "project": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "readerLabel": {
                    "description": "Only namespaces labelled `\u003clabelPrefix\u003e/sos-reader=\u003creaderLabel\u003e` may use the store; carbon sets it on its platform namespace.",
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+$"
                }
            },
            "additionalProperties": false
        },
        "upstream": {
            "description": "external-secrets 2.7.0 values: upstream defaults plus LPSM labels, Reloader, pod non-root and limits.",
            "type": "object",
            "properties": {
                "certController": {
                    "type": "object",
                    "properties": {
                        "podSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "commonLabels": {
                    "type": "object",
                    "properties": {
                        "atomi.cloud/layer": {
                            "type": "string"
                        },
                        "atomi.cloud/module": {
                            "type": "string"
                        },
                        "atomi.cloud/platform": {
                            "type": "string"
                        },
                        "atomi.cloud/service": {
                            "type": "string"
                        }
                    }
                },
                "crds": {
                    "type": "object",
                    "properties": {
                        "annotations": {
                            "type": "object",
                            "properties": {
                                "argocd.argoproj.io/sync-options": {
                                    "type": "string"
                                },
                                "helm.sh/resource-policy": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "fullnameOverride": {
                    "type": "string"
                },
                "global": {
                    "type": "object",
                    "properties": {
                        "podAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "podSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "webhook": {
                    "type": "object",
                    "properties": {
                        "podSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
