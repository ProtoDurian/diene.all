{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Sulfur Values",
    "description": "Generated schema for the diene sulfur cert-manager engine wrapper.",
    "type": "object",
    "properties": {
        "labelPrefix": {
            "description": "Prefix used by every service-tree label.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        },
        "upstream": {
            "description": "cert-manager v1.20.3 values: upstream defaults plus CRDs, Gateway API, LPSM labels, Reloader, container non-root and limits. No Issuer/ClusterIssuer (zinc owns the issuer set). CRDs are plain templates (no skipCrds, no SSA: each is under the client-side apply annotation limit) and are kept on uninstall.",
            "type": "object",
            "properties": {
                "cainjector": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "deploymentAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "config": {
                    "type": "object",
                    "properties": {
                        "apiVersion": {
                            "type": "string"
                        },
                        "enableGatewayAPI": {
                            "type": "boolean"
                        },
                        "kind": {
                            "type": "string"
                        }
                    }
                },
                "containerSecurityContext": {
                    "type": "object",
                    "properties": {
                        "runAsNonRoot": {
                            "type": "boolean"
                        }
                    }
                },
                "crds": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "keep": {
                            "type": "boolean"
                        }
                    }
                },
                "deploymentAnnotations": {
                    "type": "object",
                    "properties": {
                        "reloader.stakater.com/auto": {
                            "type": "string"
                        }
                    }
                },
                "global": {
                    "type": "object",
                    "properties": {
                        "commonLabels": {
                            "type": "object",
                            "properties": {
                                "atomi.cloud/layer": {
                                    "type": "string"
                                },
                                "atomi.cloud/module": {
                                    "type": "string"
                                },
                                "atomi.cloud/platform": {
                                    "type": "string"
                                },
                                "atomi.cloud/service": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "nameOverride": {
                    "type": "string"
                },
                "resources": {
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "startupapicheck": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "webhook": {
                    "type": "object",
                    "properties": {
                        "containerSecurityContext": {
                            "type": "object",
                            "properties": {
                                "runAsNonRoot": {
                                    "type": "boolean"
                                }
                            }
                        },
                        "deploymentAnnotations": {
                            "type": "object",
                            "properties": {
                                "reloader.stakater.com/auto": {
                                    "type": "string"
                                }
                            }
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "limits": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "requests": {
                                    "type": "object",
                                    "properties": {
                                        "cpu": {
                                            "type": "string"
                                        },
                                        "memory": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
