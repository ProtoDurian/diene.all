                        }
                    }
                },
                "requireNonRoot": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "requireResources": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "restrictAppArmor": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "restrictSELinux": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "restrictSeccomp": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "restrictSysctls": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "restrictVolumeTypes": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "hostPathCarveOut": {
                            "description": "The one hostPath allowance: these exact paths, for this ServiceAccount in this namespace (alloy-logs). Empty `serviceAccount` disables it.",
                            "type": "object",
                            "properties": {
                                "namespace": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                                },
                                "paths": {
                                    "type": "array",
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "serviceAccount": {
                                    "type": "string",
                                    "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
                                }
                            }
                        }
                    }
                }
            }
        },
        "serviceTree": {
            "description": "Stable four-slot service-tree projection. Landscape and cluster are added by independent overlays.",
            "type": "object",
            "required": [
                "platform",
                "service",
                "module",
                "layer"
            ],
            "properties": {
                "layer": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "module": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "platform": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                },
                "service": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                }
            }
        }
    }
}
