{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Diene Vanadium Values",
    "description": "Generated schema for the diene vanadium ValidatingAdmissionPolicy chart.",
    "type": "object",
    "required": [
        "fullnameOverride",
        "enforcement",
        "exemptionLabel"
    ],
    "properties": {
        "enforcement": {
            "description": "Landscape posture. `audit` binds every policy `[Warn, Audit]` (nothing blocked); `deny` binds `[Deny]`.",
            "type": "string",
            "enum": [
                "audit",
                "deny"
            ]
        },
        "exemptionLabel": {
            "description": "Namespaces labeled `\u003clabelPrefix\u003e/\u003cexemptionLabel\u003e: \"true\"` are skipped by every binding.",
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "minLength": 1
        },
        "fullnameOverride": {
            "description": "Release fullname. It must be `\u003cservice\u003e-\u003cmodule\u003e`.",
            "type": "string",
            "pattern": "^[a-z0-9]+-[a-z0-9]+$"
        },
        "labelPrefix": {
            "description": "Prefix used by every service-tree label, annotation and policy key.",
            "type": "string",
            "pattern": "^[a-z0-9.-]+$",
            "minLength": 1
        },
        "policies": {
            "description": "One ValidatingAdmissionPolicy + binding per enabled policy. A non-empty `actions` overrides the landscape posture for that policy.",
            "type": "object",
            "properties": {
                "disallowCapabilities": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowHostNamespaces": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowHostPorts": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowHostProcess": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowLatest": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowNodePort": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowPrivEscalation": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowPrivileged": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "disallowProcMount": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "landscapeMatch": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                },
                "layerRange": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "layers": {
                            "description": "Accepted `\u003clabelPrefix\u003e/layer` values.",
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "platformAccepted": {
                    "type": "object",
                    "properties": {
                        "actions": {
                            "type": "array",
                            "maxItems": 2,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "Warn",
                                    "Audit",
                                    "Deny"
                                ]
                            }
                        },
                        "enabled": {
