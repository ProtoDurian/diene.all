{
  "requiredEntryKeys": ["name", "region"],
  "requiredKeys": ["landscapes", "platform", "tier"],
  "topLevelRule": "exactly the keys landscapes, platform, tier; platform and tier are non-empty strings; landscapes is an array; any other top-level key is rejected; a doc violating any rule is untrusted as a whole",
