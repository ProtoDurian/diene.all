{
  "name": "aseity",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp*", "/.well-known/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // Local dev only: the compose.dev.yaml Postgres; wrangler dev never reads the remote id.
      "localConnectionString": "postgres://aseity:aseity@127.0.0.1:5432/aseity"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:8787",
    "OAUTH_PROXY_URL": "",
    "TENANT_APPROVAL": "manual",
    "S3_ENDPOINT": "http://127.0.0.1:9000",
    "S3_BUCKET": "aseity",
    "S3_REGION": "auto",
    "MAIL_FROM": "Aseity <no-reply@localhost>"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "MAIL_API_KEY"
    ]
  },
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    // The deployed Worker. Values here must match infra/tofu/production.tfvars.
    "production": {
      "name": "aseity",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // Replace with `tofu output -raw hyperdrive_id` after the first apply.
          "id": "00000000000000000000000000000000"
        }
      ],
      "vars": {
        "APP_URL": "https://aseity.example.com",
        "OAUTH_PROXY_URL": "https://aseity.example.com",
        "TENANT_APPROVAL": "manual",
        "S3_ENDPOINT": "https://t3.storage.dev",
        "S3_BUCKET": "aseity-files",
        "S3_REGION": "auto",
        "MAIL_FROM": "Aseity <no-reply@aseity.example.com>"
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "S3_ACCESS_KEY_ID",
          "S3_SECRET_ACCESS_KEY",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "MAIL_API_KEY"
        ]
      },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
